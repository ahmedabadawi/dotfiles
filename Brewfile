# brew bundle --file=Brewfile
# The macOS analog of `apt install -y $(cat pkglist)` — makes a fresh
# machine reproducible with one command. Already-installed tools stay
# declared here on purpose; `brew bundle` just skips them.

# --- dotfiles tooling -----------------------------------------------------
brew "stow"
brew "starship"
brew "neovim"
brew "git"        # modern git, not macOS's ancient Xcode CLT git
brew "tmux"

# --- modern CLI replacements -----------------------------------------------
brew "eza"          # ls
brew "bat"          # cat
brew "fd"           # find
brew "ripgrep"      # grep
brew "zoxide"       # cd
brew "fzf"          # fuzzy finder
brew "yazi"         # terminal file manager
brew "git-delta"    # git diff pager

# --- yazi preview extras --------------------------------------------------
brew "poppler"      # PDF preview
brew "chafa"        # terminal image preview

# --- GNU tools (Linux parity) ------------------------------------------
brew "coreutils"
brew "findutils"
brew "gnu-sed"
brew "grep"
brew "gawk"
brew "gnu-tar"

# --- casks -----------------------------------------------------------------
cask "alacritty"
cask "font-jetbrains-mono-nerd-font"
